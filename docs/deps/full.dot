digraph G {
rankdir=BT; newrank=true; compound=true; splines=true; nodesep=0.35; ranksep=0.9; pad=0.4;
label=<<b>InkPDF module dependencies (all 158 edges; arrows point at what is used; line weight = uses)</b>>; labelloc=t; fontsize=22; fontname="Helvetica";
node [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=13, margin="0.14,0.07", color="#888888"];
edge [arrowsize=0.6];
subgraph cluster_Base { label="base — plain data and arithmetic"; labeljust=l; fontname="Helvetica"; fontsize=14; style="rounded,filled"; fillcolor="#e8f1fb55"; color="#4a7fb5";
  "clipboard" [fillcolor="white"];
  "clock" [fillcolor="white"];
  "colour" [fillcolor="white"];
  "coords" [fillcolor="white"];
  "geometry" [fillcolor="white"];
  "motion" [fillcolor="white"];
  "palette" [fillcolor="white"];
  "plane" [fillcolor="white"];
  "scene" [fillcolor="white"];
  "smooth" [fillcolor="white"];
  "text" [fillcolor="white"];
  "view" [fillcolor="white"];
}
subgraph cluster_Model { label="model — what a drawing is made of"; labeljust=l; fontname="Helvetica"; fontsize=14; style="rounded,filled"; fillcolor="#e3f4ea55"; color="#3a8f5c";
  "doctext" [fillcolor="white"];
  "figure" [fillcolor="white"];
  "ink" [fillcolor="white"];
  "laser" [fillcolor="white"];
  "links" [fillcolor="white"];
  "outline" [fillcolor="white"];
  "page_table" [fillcolor="white"];
  "pages" [fillcolor="white"];
  "pagetext" [fillcolor="white"];
}
subgraph cluster_Domain { label="domain — what devices and tools mean"; labeljust=l; fontname="Helvetica"; fontsize=14; style="rounded,filled"; fillcolor="#fdf3d655"; color="#b8860b";
  "browse" [fillcolor="white"];
  "input" [fillcolor="white"];
  "requests" [fillcolor="white"];
  "selection" [fillcolor="white"];
  "settings" [fillcolor="white"];
  "store" [fillcolor="white"];
  "tool" [fillcolor="white"];
  "workspace" [fillcolor="white"];
}
subgraph cluster_Ui { label="ui — buttons as data"; labeljust=l; fontname="Helvetica"; fontsize=14; style="rounded,filled"; fillcolor="#f6e4f355"; color="#a14a96";
  "toolbar" [fillcolor="white"];
}
subgraph cluster_Tools { label="tools — what a press on the page does"; labeljust=l; fontname="Helvetica"; fontsize=14; style="rounded,filled"; fillcolor="#fde5d455"; color="#d2691e";
  "tools" [fillcolor="white"];
}
subgraph cluster_Session { label="session — editor: routing, chrome, history"; labeljust=l; fontname="Helvetica"; fontsize=14; style="rounded,filled"; fillcolor="#e4e1f855"; color="#6a5acd";
  "editor" [fillcolor="white"];
}
subgraph cluster_Adapter { label="adapter — window, GPU, files, OS"; labeljust=l; fontname="Helvetica"; fontsize=14; style="rounded,filled"; fillcolor="#e6e6e655"; color="#555555";
  "app" [fillcolor="white"];
  "doc" [fillcolor="white"];
  "gpu" [fillcolor="white"];
  "indexer" [fillcolor="white"];
  "ink_io" [fillcolor="white"];
  "path_store" [fillcolor="white"];
  "pdf" [fillcolor="white"];
  "pdf_read" [fillcolor="white"];
  "platform" [fillcolor="white" penwidth=2.5 color="#c0392b" fontcolor="#c0392b"];
  "thumbnail" [fillcolor="white"];
  "tiles" [fillcolor="white"];
}
